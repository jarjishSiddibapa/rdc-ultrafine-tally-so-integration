# Copy to .env and fill in. Never commit .env.
APP_ENV=development            # production enforces COOKIE_SECURE=true and hides /docs
HOST=127.0.0.1                 # use 0.0.0.0 only behind a firewall / reverse proxy
PORT=1401
SECRET_KEY=                    # python -c "import secrets;print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false            # must be true when served over HTTPS (production)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=tally_so
TEST_DB_NAME=tally_so_test

# Used only by: python -m app.cli seed-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Leave blank until the Tally API is available
TALLY_API_URL=
TALLY_API_TOKEN=

# Outgoing email for password resets and notifications (Google Workspace app password works; spaces are ignored)
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                  # 587 with SMTP_SECURITY=starttls, or 465 with SMTP_SECURITY=ssl
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Ultrafine Sales Orders
APP_BASE_URL=http://localhost:1401   # emailed links use this; set to the address your staff really use
